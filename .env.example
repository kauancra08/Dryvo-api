# Configurações do Banco de Dados PostgreSQL (Local ou Supabase)
DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DB_USER=postgres
DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD
DB_NAME=postgres

# Configurações de Execução do Servidor
SERVER_PORT=8085
JWT_SECRET=dev-only-secret-change-me-dev-only-secret-change-me
SPRING_PROFILES_ACTIVE=dev
